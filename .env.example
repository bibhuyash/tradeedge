# TradeEdge Phase 0 is paper-only. Do not place credentials in this file.
TRADEEDGE_ENV=development
TRADEEDGE_HTTP_ADDR=:8080
TRADEEDGE_LOG_LEVEL=info
TRADEEDGE_SHUTDOWN_TIMEOUT=10s
TRADEEDGE_TRADING_MODE=paper
# Phase 5 integration is non-mutating and OFFLINE by default.
TRADEEDGE_ZERODHA_MODE=OFFLINE
TRADEEDGE_ZERODHA_READ_ONLY=true
# Optional bounded read-only adapter settings. PAPER uses the production
# observation composition and remains NOT_READY until all real dependencies pass.
TRADEEDGE_ZERODHA_BASE_URL=https://api.kite.trade
TRADEEDGE_ZERODHA_TIMEOUT=2s
TRADEEDGE_ZERODHA_MAX_CONCURRENCY=4
TRADEEDGE_ZERODHA_READ_RETRIES=2
TRADEEDGE_ZERODHA_MAPPING_MAX_AGE=24h
# Copy this file to the git-ignored .env used by Docker Compose. Supply either a
# fresh one-time request token, or an access token plus its RFC3339 expiry. Never
# commit .env or copy its values into logs/evidence.
# SHADOW preflight uses -credentials-file .env to atomically persist only the
# exchanged access token and expiry; later preflight/runtime reuse that session.
TRADEEDGE_ZERODHA_API_KEY=
TRADEEDGE_ZERODHA_API_SECRET=
TRADEEDGE_ZERODHA_REQUEST_TOKEN=
TRADEEDGE_ZERODHA_ACCESS_TOKEN=
TRADEEDGE_ZERODHA_ACCESS_TOKEN_EXPIRES_AT=
# Optional read-only operational data. Leave empty to report market data DISABLED.
TRADEEDGE_MARKETDATA_CALENDAR=
TRADEEDGE_MARKETDATA_DATASET_ROOT=
# Required for separately authorized real-market PAPER or SHADOW observation.
# SHADOW uses TRADEEDGE_TRADING_MODE=shadow, TRADEEDGE_ZERODHA_MODE=SHADOW, a
# SHADOW bundle, and QUALIFICATION_ONLY authorization. Keep pinned files
# non-secret; credentials remain in the approved secret mechanism.
TRADEEDGE_RUNTIME_BUNDLE=
TRADEEDGE_CHECKPOINT_ROOT=
TRADEEDGE_OPERATOR_CONTROL_SOCKET=
TRADEEDGE_AUTHORIZATION_MANIFEST_HOST=.cache/market-validation/YYYY-MM-DD/authorization-COMMIT.json
# Phase 2 strategy runner bounds. No strategy is enabled by these settings.
TRADEEDGE_STRATEGY_MAX_CONCURRENCY=4
TRADEEDGE_STRATEGY_TIMEOUT=100ms
TRADEEDGE_RISK_MAX_CONCURRENCY=4
TRADEEDGE_RISK_TIMEOUT=100ms
# Telegram is optional and outbound-only. When enabled, inject
# TRADEEDGE_TELEGRAM_BOT_TOKEN and TRADEEDGE_TELEGRAM_CHAT_ID securely.
TRADEEDGE_TELEGRAM_ENABLED=false
TRADEEDGE_TELEGRAM_BOT_TOKEN=
TRADEEDGE_TELEGRAM_CHAT_ID=
